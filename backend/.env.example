# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Database (required) ──────────────────────────────────
MONGO_URI=mongodb://localhost:27017/dociq

# ─── Ingestion queue (optional) ──────────────────────────
# false → documents are parsed/embedded synchronously during upload
USE_QUEUE=false
REDIS_URL=redis://localhost:6379

# ─── Demo data ───────────────────────────────────────────
# true → on startup, create a "Demo — Sample MSA" workspace with the sample
#        contract already ingested (idempotent). Always on for `npm run dev:mem`.
SEED_DEMO=false

# ─── Vector store ────────────────────────────────────────
# memory | chroma
VECTOR_STORE=memory
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=dociq

# ─── LLM provider ────────────────────────────────────────
# gemini | groq | openai | extractive
# extractive needs no API key — answers are stitched from retrieved chunks
LLM_PROVIDER=extractive
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Embedding provider ──────────────────────────────────
# local | gemini
# local needs no API key — deterministic hashed bag-of-words vectors
EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=384

# ─── Default workspace settings (overridable per workspace at runtime) ──
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
DEFAULT_RETRIEVAL_STRATEGY=vector
DEFAULT_CONFIDENCE_THRESHOLD=0.15
